# Copy to an untracked production environment file on the VPS.
# Never commit real values. Release image references should be immutable tags or digests.

APP_IMAGE=ghcr.io/example/songchart-next-app@sha256:REPLACE_ME
WEB_IMAGE=ghcr.io/example/songchart-next-web@sha256:REPLACE_ME
APP_URL=https://example.invalid
APP_KEY=REPLACE_WITH_LARAVEL_APP_KEY

POSTGRES_DB=songchart
POSTGRES_USER=songchart
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD

# Bind publicly only when host firewall/TLS exposure is intentionally configured.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Backup contract. BACKUP_DIR may be a protected local staging path, but a
# successful release backup is not complete until the resulting file is copied
# to independent off-host storage and verified there.
BACKUP_DIR=/var/backups/songchart
