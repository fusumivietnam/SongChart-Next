{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SongChart: Auto Start",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/dev_up.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "SongChart: Check Git Updates",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/git_workspace_status.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
