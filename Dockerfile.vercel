# syntax=docker/dockerfile:1
# Preview-only single HTTP container for Vercel. Production remains governed by ADR-0015.
FROM php:8.4-cli-bookworm AS php-extension-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev libicu-dev libonig-dev libzip-dev libsqlite3-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql pdo_sqlite intl mbstring zip opcache \
    && rm -rf /var/lib/apt/lists/*

FROM php:8.4-cli-bookworm AS php-runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libpq5 libicu72 libonig5 libzip4 libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=php-extension-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-extension-builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
WORKDIR /var/www/html

FROM composer:2 AS composer-bin
FROM node:22-bookworm AS node-bin

FROM php-runtime AS build
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
COPY --from=node-bin /usr/local/bin/node /usr/local/bin/node
COPY --from=node-bin /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install --global --ignore-scripts pnpm@10.17.1
COPY . .
RUN mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && composer install --no-dev --prefer-dist --no-interaction --no-progress --optimize-autoloader \
    && pnpm install --frozen-lockfile \
    && pnpm run build \
    && pnpm run types:check

FROM php-runtime AS preview
COPY --from=build /var/www/html /var/www/html
COPY deploy/vercel/start.sh /usr/local/bin/songchart-preview-start
RUN chmod 0755 /usr/local/bin/songchart-preview-start \
    && chown -R www-data:www-data storage bootstrap/cache
USER www-data
ENV APP_ENV=preview \
    APP_DEBUG=false \
    DB_CONNECTION=pgsql \
    SESSION_DRIVER=file \
    QUEUE_CONNECTION=sync \
    CACHE_STORE=file \
    MUSICBRAINZ_LIVE_ENABLED=false
EXPOSE 3000
CMD ["songchart-preview-start"]
